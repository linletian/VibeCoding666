{
  "name": "vibecoding666",
  "version": "0.3.4",
  "description": "VibeCoding666 - 跨平台屏幕软键盘，支持自定义按键内容",
  "license": "MIT",
  "author": "VibeCoding666 Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linletian/vibecoding666.git"
  },
  "homepage": "https://github.com/linletian/vibecoding666#readme",
  "bugs": {
    "url": "https://github.com/linletian/vibecoding666/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "npm rebuild --runtime=electron --target=22.3.27 --disturl=https://electronjs.org/headers --abi=110",
    "uninstall:mac": "bash scripts/uninstall-macos.sh",
    "uninstall:linux": "bash scripts/uninstall-linux.sh"
  },
  "build": {
    "appId": "com.vibecoding666.app",
    "productName": "VibeCoding666",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "nsis": {
      "include": "scripts/nsis-uninstall.nsh"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility"
    }
  },
  "devDependencies": {
    "electron": "^22.3.27",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "robotjs": "^0.6.0"
  },
  "overrides": {
    "node-abi": "^3.77.0"
  }
}
